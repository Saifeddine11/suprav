Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. HTTPS + domaine canonique www
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^www\.suprav3\.com$ [NC]
  RewriteRule ^ https://www.suprav3.com%{REQUEST_URI} [R=301,L]

  # 2. Redirections 301 — alias → URL canonique
  RewriteRule ^automatisation-ia/?$ /automatisation-ia-marrakech [R=301,L]
  RewriteRule ^community-management-marrakech/?$ /gestion-reseaux-sociaux-marrakech [R=301,L]
  RewriteRule ^production-contenu/?$ /agence-video-marrakech [R=301,L]
  RewriteRule ^agence-web-marrakech/?$ /creation-site-web-marrakech [R=301,L]
  RewriteRule ^redaction-web-seo/?$ /referencement-seo-marrakech [R=301,L]
  RewriteRule ^audit-seo/?$ /referencement-seo-marrakech [R=301,L]

  # 3. API
  RewriteRule ^api/contact/?$ /api/contact.php [L,QSA]

  # 4. Fichiers et dossiers existants (HTML pré-rendu)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 5. Fallback SPA React Router
  RewriteRule ^ /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always unset X-Robots-Tag
  <FilesMatch "\.(html?)$">
    Header always set X-Robots-Tag "all"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; media-src 'self'; connect-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; form-action 'self'; upgrade-insecure-requests"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>
